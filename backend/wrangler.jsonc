{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-03",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "deltatime_dev",
			"database_name": "deltatime-dev",
			"database_id": "9e31af0f-0f05-4a06-98df-5f6c647ef05b"
		}
	],
	"env": {
		"demo": {
			"workers_dev": true,
			"d1_databases": [
				{
					"binding": "deltatime_dev",
					"database_name": "deltatime-demo",
					"database_id": "155212b7-00b5-462c-9f83-bb0bae2831b7"
				}
			]
		}
	}
}